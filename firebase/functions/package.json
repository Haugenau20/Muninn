{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "test": "jest",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "operator:dev": "npm run build && node --env-file=operator/dev.env lib/operator/dev.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.6",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^10.9.1",
    "nodemailer": "^10.1.7",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "firebase": "^13.1.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
