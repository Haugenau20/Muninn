{
  "name": "dnd-recap",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@fontsource/noto-sans-runic": "5.3.0",
    "@fontsource/zilla-slab": "5.3.0",
    "@types/jest": "^27.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "baseline-browser-mapping": "^2.10.32",
    "caniuse-lite": "^1.0.30001793",
    "clsx": "^2.1.0",
    "dotenv": "^16.3.1",
    "firebase": "^11.3.0",
    "lucide-react": "^0.507.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-breaks": "^4.0.0",
    "tailwind-merge": "^2.2.0"
  },
  "scripts": {
    "predeploy": "npm run build",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:bundle": "node scripts/check-bundle-size.js",
    "lint": "eslint --max-warnings 0 --rule \"import/no-cycle: error\" src --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.test.tsx\" --ignore-pattern \"src/test-utils/**\" --ignore-pattern \"src/__mocks__/**\" --ignore-pattern src/setupTests.ts",
    "lint:tests": "node scripts/check-test-lint.js",
    "test": "jest",
    "deploy": "npm run build && firebase deploy",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "test:html": "jest --config=jest.config.html.ts --coverage && echo 'HTML report generated at ./test-reports/jest-html-report.html'",
    "test:behavioral": "jest --testPathPattern=behavioral --coverage",
    "test:behavioral:html": "jest --config=jest.config.html.ts --testPathPattern=behavioral --coverage && echo 'Behavioral test HTML report generated at ./test-reports/jest-html-report.html'",
    "test:open": "npm run test:html && (command -v xdg-open >/dev/null && xdg-open test-reports/jest-html-report.html || echo 'Please open test-reports/jest-html-report.html in your browser')"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.14.202",
    "@types/node": "^22.13.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.17",
    "babel-jest": "^29.7.0",
    "confusing-browser-globals": "^1.0.11",
    "eslint": "^10.12.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-extended": "^4.0.2",
    "jest-html-reporter": "^4.1.0",
    "msw": "^2.7.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
